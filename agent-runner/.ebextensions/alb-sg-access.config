Resources:
  # Allow CloudFront origin-facing IPs (us-east-1 managed prefix list) to reach the ALB.
  # This rule persists across EB redeployments, unlike manual SG edits.
  CloudFrontHTTPIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBLoadBalancerSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 80
      ToPort: 80
      SourcePrefixListId: pl-3b927c52

  # Allow the meet EB instance security group to call agent-runner directly (server-to-server).
  MeetEBIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBLoadBalancerSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 80
      ToPort: 80
      SourceSecurityGroupId: sg-027fd5d325ada3034
