# Installs Grafana Alloy as a sidecar on the EB instance.
# Alloy scrapes the agent-runner /metrics endpoint every 15s via the local
# nginx proxy (port 80 → container port 7860) and remote-writes to Grafana
# Cloud Prometheus.
#
# Required EB environment properties (set in EB console → Configuration → Software):
#   GRAFANA_PROM_REMOTE_WRITE_URL  — e.g. https://prometheus-prod-13-prod-us-east-0.grafana.net/api/prom/push
#   GRAFANA_PROM_USER_ID           — numeric Prometheus instance ID (from Grafana Cloud stack details)
#   GRAFANA_PROM_API_KEY           — Grafana Cloud API key with metrics:write scope

files:
  "/etc/systemd/system/grafana-alloy.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Grafana Alloy — Prometheus scraper
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      ExecStart=/usr/local/bin/alloy run /etc/alloy/meetlab.alloy
      Restart=on-failure
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  "/etc/yum.repos.d/grafana.repo":
    mode: "000644"
    owner: root
    group: root
    content: |
      [grafana]
      name=Grafana
      baseurl=https://rpm.grafana.com
      repo_gpgcheck=1
      enabled=1
      gpgcheck=1
      gpgkey=https://rpm.grafana.com/gpg.key
      sslverify=1
      sslcacert=/etc/pki/tls/certs/ca-bundle.crt

commands:
  01_install_alloy:
    command: |
      set -e
      command -v alloy && exit 0
      yum install -y alloy

  02_write_alloy_config:
    command: |
      set -e
      mkdir -p /etc/alloy
      printf 'prometheus.scrape "agent_runner" {\n  targets = [{"__address__" = "localhost:80", "job" = "meetlab-agent-runner"}]\n  scrape_interval = "15s"\n  metrics_path    = "/metrics"\n  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]\n}\n\nprometheus.remote_write "grafana_cloud" {\n  endpoint {\n    url = "%s"\n    basic_auth {\n      username = "%s"\n      password = "%s"\n    }\n  }\n}\n' \
        "${GRAFANA_PROM_REMOTE_WRITE_URL}" \
        "${GRAFANA_PROM_USER_ID}" \
        "${GRAFANA_PROM_API_KEY}" \
        > /etc/alloy/meetlab.alloy

  03_start_alloy:
    command: |
      systemctl daemon-reload
      systemctl enable grafana-alloy
      systemctl restart grafana-alloy
