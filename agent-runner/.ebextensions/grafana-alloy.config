# Installs Grafana Alloy as a sidecar on the EB instance.
# Alloy scrapes the agent-runner /metrics endpoint every 15s via the local
# nginx proxy (port 80 → container port 7860) and remote-writes to Grafana
# Cloud Prometheus.
#
# Required EB environment properties (set in EB console → Configuration → Software):
#   GRAFANA_PROM_REMOTE_WRITE_URL  — e.g. https://prometheus-prod-13-prod-us-east-0.grafana.net/api/prom/push
#   GRAFANA_PROM_USER_ID           — numeric Prometheus instance ID (from Grafana Cloud stack details)
#   GRAFANA_PROM_API_KEY           — Grafana Cloud API key with metrics:write scope

files:
  "/etc/systemd/system/grafana-alloy.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Grafana Alloy — Prometheus scraper
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      ExecStart=/usr/local/bin/alloy run /etc/alloy/meetlab.alloy
      Restart=on-failure
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

commands:
  01_install_alloy:
    command: |
      set -e
      ALLOY_VERSION="1.8.2"
      INSTALLED=$(/usr/local/bin/alloy --version 2>&1 | grep -o 'v[0-9.]*' | head -1 || true)
      if [ "${INSTALLED}" != "v${ALLOY_VERSION}" ]; then
        curl -fsSL -o /tmp/alloy \
          "https://github.com/grafana/alloy/releases/download/v${ALLOY_VERSION}/alloy-linux-amd64"
        install -m 755 /tmp/alloy /usr/local/bin/alloy
        rm -f /tmp/alloy
      fi

  02_write_alloy_config:
    # EB environment properties are available as shell env vars during commands.
    # We bake them into the config file so Alloy doesn't need them at runtime.
    # Scrape via localhost:80 — EB nginx always listens on port 80 and proxies
    # to the Docker container, so this works regardless of Docker port mapping.
    command: |
      set -e
      mkdir -p /etc/alloy
      cat > /etc/alloy/meetlab.alloy << EOF
      prometheus.scrape "agent_runner" {
        targets = [{"__address__" = "localhost:80", "job" = "meetlab-agent-runner"}]
        scrape_interval = "15s"
        metrics_path    = "/metrics"
        forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
      }

      prometheus.remote_write "grafana_cloud" {
        endpoint {
          url = "${GRAFANA_PROM_REMOTE_WRITE_URL}"
          basic_auth {
            username = "${GRAFANA_PROM_USER_ID}"
            password = "${GRAFANA_PROM_API_KEY}"
          }
        }
      }
      EOF

  03_start_alloy:
    command: |
      systemctl daemon-reload
      systemctl enable grafana-alloy
      systemctl restart grafana-alloy
