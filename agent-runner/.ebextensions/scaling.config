# agent-runner capacity.
#
# Sizing basis (measured, not guessed): during the 2026-07-30 pilot the runner hit
# 84.5% average CPU at 7 concurrent sessions on a 2-vCPU t3.medium — roughly
# 0.24 vCPU per session. See docs/scale-readiness-plan.md (C2).
#
# Target is 50 concurrent sessions ≈ 12 vCPU of real work. c6i.xlarge is 4 vCPU,
# so 2 instances idle / 6 at full stretch gives 8–24 vCPU: comfortable headroom at
# the target, and small enough instances that losing one is not half the fleet.
#
# Why not t3: burstable. At pilot CPU a t3.medium nets about -78 credits/hour
# against a 576 cap, so a sustained rush exhausts credits in ~7 hours and then
# throttles to the 20% baseline. Short tastings survive that; a dinner rush does
# not. c6i is fixed-performance.
#
# Two caveats that this file does NOT solve:
#   1. The runner leaks ~150 MB per bot session (postmortem). Autoscaling spreads
#      the load but does not stop the leak; instances still need recycling.
#   2. `POST /recordings/start` looks up a per-process audio-sink registry, so a
#      manual recording request routed to the wrong instance silently finds no
#      sink. Auto-record is unaffected (it runs inside the bot's own process).
#      Endpoint saw 2 hits in 30 days, so this is low risk but real.
#
# Re-measure CPU per session after the RC1 fix before trusting these numbers:
# faster turn commits mean more turns per minute, so CPU per session goes UP.

option_settings:
  aws:autoscaling:launchconfiguration:
    InstanceType: c6i.xlarge

  aws:autoscaling:asg:
    MinSize: 2
    MaxSize: 6

  # Scale on CPU. Thresholds sit well below the 85% we measured at saturation so
  # a new instance is warming before the current ones degrade.
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    Period: 1
    BreachDuration: 2
    UpperThreshold: 60
    UpperBreachScaleIncrement: 2
    LowerThreshold: 20
    LowerBreachScaleIncrement: -1

  # Rolling replacement so a config change never takes the fleet down at once.
  aws:autoscaling:updatepolicy:rollingupdate:
    RollingUpdateEnabled: true
    RollingUpdateType: Health
    MaxBatchSize: 1
    MinInstancesInService: 1
