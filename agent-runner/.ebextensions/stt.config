# Point the bot's STT at the self-hosted Parakeet NIM. NemotronHTTPSTTService POSTs
# /v1/audio/transcriptions with the NIM's served model id + language (client defaults match).
# NEMOTRON_STT_URL is the NIM instance's private IP (no stable DNS yet — update if the box is
# replaced). See docs/gpu-stt-deployment.md.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NEMOTRON_STT_URL: http://10.0.5.21:9000
