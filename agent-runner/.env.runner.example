OPENAI_API_KEY=your_openai_api_key

# LiveKit (Docker Compose defaults)
LIVEKIT_URL=ws://transport-server:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Shared bearer token — must match BOT_RUNNER_SECRET in meet/.env.local.
# When set, all /start /events /config calls require Authorization: Bearer <secret>.
BOT_RUNNER_SECRET=changeme

# Postgres
# Local dev: set by docker-compose, no need to override here
# DATABASE_URL=postgresql+asyncpg://meetlab:meetlab@localhost:5432/meetlab
# Production (RDS): include ?ssl=require
# DATABASE_URL=postgresql+asyncpg://user:pass@your-instance.us-east-1.rds.amazonaws.com:5432/meetlab?ssl=require
