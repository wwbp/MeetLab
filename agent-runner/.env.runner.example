OPENAI_API_KEY=your_openai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# LiveKit (Docker Compose defaults)
LIVEKIT_URL=ws://transport-server:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Shared bearer token — must match BOT_RUNNER_SECRET in meet/.env.local.
# When set, all /start /events /config calls require Authorization: Bearer <secret>.
BOT_RUNNER_SECRET=changeme

# ── Bot session lifecycle ────────────────────────────────────────────────────
# Bot JWT lifetime in minutes (default 15). Raise for sessions >15 min, e.g. the
# 20-min soak (`make soak` passes 30). LiveKit drops the bot at token expiry.
# BOT_TOKEN_TTL_MINUTES=15
# Safety-net sweep that closes conversations stuck on 'running' whose LiveKit room
# is gone (hard bot death). Interval in seconds; set DISABLE to turn it off.
# CONVERSATION_RECONCILE_INTERVAL_SECONDS=120
# DISABLE_CONVERSATION_RECONCILE=false

# ── Self-hosted STT (Parakeet NIM) ───────────────────────────────────────────
# parakeet-* models POST VAD-cut segments to the Parakeet NIM's OpenAI-compatible
# endpoint (/v1/audio/transcriptions). Set NEMOTRON_STT_URL to a reachable NIM (prod
# sets it on the EB env). Local dev doesn't need it: STT_MODEL_OVERRIDE=whisper-base
# (docker-compose) transcribes in-process. See docs/gpu-stt-deployment.md.
# NEMOTRON_STT_URL=http://10.0.5.21:9000

# Postgres
# Local dev: set by docker-compose, no need to override here
# DATABASE_URL=postgresql+asyncpg://meetlab:meetlab@localhost:5432/meetlab
# Production (RDS): include ?ssl=require
# DATABASE_URL=postgresql+asyncpg://user:pass@your-instance.us-east-1.rds.amazonaws.com:5432/meetlab?ssl=require

# ── Storage (recordings + transcripts) ──────────────────────────────────────
# "local" writes to RECORDINGS_PATH (the shared ../recordings volume).
# "s3" uploads to S3; all S3_* vars required.
STORAGE_BACKEND=local
RECORDINGS_PATH=/recordings
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_BUCKET=meetlab-data
# S3_REGION=us-east-1
# S3_ENDPOINT=          # optional: S3-compatible endpoint (MinIO, R2, etc.)
# PRESIGNED_URL_TTL_SECONDS=3600

# ── OpenTelemetry tracing ────────────────────────────────────────────────────
# Local dev: enable with Jaeger (add ENABLE_TRACING=true to .env.runner.local)
# ENABLE_TRACING=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_CONSOLE_EXPORT=false
#
# Production (Grafana Cloud):
# ENABLE_TRACING=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceId:apiToken)>
# OTEL_CONSOLE_EXPORT=false
