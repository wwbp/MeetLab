# meet is deliberately pinned to a single instance. This is a correctness
# constraint, not a capacity choice, and it should not be "fixed" by raising
# MaxSize.
#
# Seven modules under meet/lib keep domain state on globalThis:
#
#   concierge/bot-room-claim-store.ts          which room already has a bot
#   concierge/bot-start-lock-store.ts          the mutex preventing double-start
#   concierge/bot-requests-store.ts            request history
#   concierge/bot-track-subscription-store.ts  per-bot track state
#   concierge/participant-presence-store.ts    who is in which room
#   concierge/events-store.ts                  (now a DB client, kept for shape)
#   rate-limit.ts                              per-process counters
#
# Those are per-process Maps. With two instances behind a load balancer, a
# request that lands on instance B cannot see the claim instance A recorded, so
# both conclude a room has no bot and start one. Rooms get two bots, and the
# start lock cannot prevent it because the lock is also per-process. Raising
# MaxSize therefore does not add capacity, it adds a race — and the symptom
# appears under exactly the load that motivated the change.
#
# The fix is to derive that state instead of storing it: bot presence is
# already authoritatively answerable from LiveKit (the bots route calls
# listParticipants and filters for the bot prefix), request history already
# lives in the events table, and the start lock belongs in a Postgres advisory
# lock. Until that lands, one instance is the only correct configuration.
#
# Vertical headroom instead. The web tier serves tokens, proxies to the runner,
# and renders the console; it is not where the load is. c6i.large doubles the
# cores of the t3.medium it replaces and drops the burst-credit cliff.
#
# tests/test_scaling_config.py fails if MaxSize is raised while globalThis state
# remains, and tells you which modules are responsible.
option_settings:
  aws:autoscaling:launchconfiguration:
    InstanceType: c6i.large

  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 1

  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Fixed
    BatchSize: 1
    Timeout: 1800
