# 1. Copy this file and rename it to .env.local
# 2. Update the environment variables below.

# REQUIRED SETTINGS
# #################
# If you are using LiveKit Cloud, the API key and secret can be generated from the Cloud Dashboard.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser-facing URL returned by /api/connection-details.
# Example: wss://my-livekit-project.livekit.cloud
LIVEKIT_URL_PUBLIC=

# Optional container-internal URL used by server-side API routes (recording/admin).
# If unset, LIVEKIT_URL_PUBLIC will be used.
# LIVEKIT_URL_INTERNAL=

# Backward-compatible fallback (used when LIVEKIT_URL_PUBLIC/LIVEKIT_URL_INTERNAL are not set).
# LIVEKIT_URL=

# OPTIONAL SETTINGS
# #################
# Recording
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# PUBLIC
# Uncomment settings menu when using LiveKit Cloud; this enables Krisp noise filters.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record

# Optional, to pipe logs to datadog
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=client-token
# NEXT_PUBLIC_DATADOG_SITE=datadog-site
