# Copy to .env.local and adjust values.
# Browser-facing URL returned to participants.
# For remote/ngrok demos, this must be publicly reachable (for example: wss://<project>.livekit.cloud).
LIVEKIT_URL_PUBLIC=ws://localhost:7880
# Container-internal URL for server-side API calls (recording/admin).
LIVEKIT_URL_INTERNAL=ws://transport-server:7880

# Backward-compatible fallback used if *_PUBLIC/*_INTERNAL are not set.
LIVEKIT_URL=ws://localhost:7880

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# FastAPI bot runner (server-side call from Next.js /api/agent-connection)
# For Docker use: BOT_RUNNER_URL=http://agent-runner:7860/
BOT_RUNNER_URL=http://localhost:7860/

# ── Recording ────────────────────────────────────────────────────────────────
# Shows the settings gear icon in the conference UI (required for record button)
NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# Activates the Recording tab inside the settings menu
NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record

# Storage backend: "local" (dev) writes to the recordings volume via the egress
# container. "s3" (staging/prod) writes directly to S3 via LiveKit Cloud egress.
STORAGE_BACKEND=local
# Path inside the egress container where recordings land (local only).
RECORDINGS_PATH=/recordings

# S3 credentials — required when STORAGE_BACKEND=s3 (staging / production).
# Bucket: meetlab-data  |  Region: us-east-1
# S3_BUCKET=meetlab-data
# S3_REGION=us-east-1
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=   # leave unset for AWS S3; set only for S3-compatible endpoints

# ── Optional observability ───────────────────────────────────────────────────
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=client-token
# NEXT_PUBLIC_DATADOG_SITE=datadog-site
